{minimum_otp_vsn, "27"}.

{erl_opts, [debug_info]}.

{pre_hooks, [
    {compile, "make physics-nif"}
]}.

{deps, [
    {ra, "3.2.0"},
    {tomerl, "0.5.0"}
]}.

{profiles, [
    {test, [
        {deps, [{proper, "1.5.0"}]}
    ]},
    {prod, [
        {relx, [
            {release, {atc_tower, "0.1.0"}, [atc_tower, sasl]},
            {dev_mode, false},
            {include_erts, false},
            {extended_start_script, true}
        ]}
    ]}
]}.

{relx, [
    {release, {atc_tower, "0.1.0"}, [atc_tower, sasl]},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true}
]}.

{shell, [
    {apps, [atc_tower]}
]}.
